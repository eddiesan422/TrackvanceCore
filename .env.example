TRACKVANCE_ENV=local
TRACKVANCE_WEB_ORIGIN=http://localhost:3000
TRACKVANCE_STORAGE_ROOT=/var/lib/trackvance
# Habilita únicamente POST /api/v1/auth/demo.
DEMO_ACCESS_ENABLED=true
# Crea únicamente los datos sintéticos demo durante el arranque.
DEMO_SEED_ENABLED=true
MAX_UPLOAD_BYTES=10485760
TRACKVANCE_MAX_ROWS=100000
# Las rutas de SecretStore se fijan dentro de Compose. El modo local directo usa
# .local/credentials, .local/keys, .local/delivery_credentials y .local/delivery_keys.
TRACKVANCE_DESTINATION_SECRETS_DIR=.local/delivery_credentials
TRACKVANCE_DESTINATION_SECRET_KEY_FILE=.local/delivery_keys/master.key
POSTGRES_DB=trackvance
POSTGRES_USER=trackvance
POSTGRES_PASSWORD=replace-with-a-local-password
# Public callback/login URL; never derive OAuth redirects from an incoming Host header.
TRACKVANCE_PUBLIC_URL=http://localhost:3000
TRACKVANCE_SSO_MICROSOFT_ENABLED=false
TRACKVANCE_SSO_MICROSOFT_CLIENT_ID=
TRACKVANCE_SSO_MICROSOFT_CLIENT_SECRET=
# Only tenant UUIDs controlled/trusted by the operator; never a wildcard.
TRACKVANCE_SSO_MICROSOFT_TRUSTED_TENANTS=
TRACKVANCE_SSO_GOOGLE_ENABLED=false
TRACKVANCE_SSO_GOOGLE_CLIENT_ID=
TRACKVANCE_SSO_GOOGLE_CLIENT_SECRET=
# SSO is optional and disabled by default. Secrets stay outside backups and Git.
# 0.7.0 presents temporary credentials once to the administrator; it sends no email.

# 0.7.0: bounded acquisition; bytes are binary units. Restart affected services.
TRACKVANCE_ACQUISITION_MAX_UPLOAD_BYTES=1073741824
TRACKVANCE_ACQUISITION_MAX_ROWS=5000000
TRACKVANCE_ACQUISITION_MAX_OBSERVED_BYTES=2147483648
TRACKVANCE_ACQUISITION_BATCH_ROWS=5000
TRACKVANCE_ACQUISITION_BATCH_BYTES=8388608
TRACKVANCE_ACQUISITION_BOUNDED_FORMAT_BYTES=10485760
TRACKVANCE_ACQUISITION_BOUNDED_FORMAT_ROWS=100000
TRACKVANCE_ACQUISITION_MEMORY_BYTES=268435456
TRACKVANCE_ACQUISITION_MIN_FREE_BYTES=536870912
TRACKVANCE_ACQUISITION_TIMEOUT_SECONDS=1800
TRACKVANCE_ACQUISITION_UPLOAD_TTL_SECONDS=86400

# C01: XLSX asíncrono independiente de JSON no lineal y de carga rápida legacy.
# Excel admite 1048576 filas físicas incluyendo el encabezado; no 5M filas XLSX.
TRACKVANCE_ACQUISITION_XLSX_MAX_ROWS=1000000
TRACKVANCE_ACQUISITION_XLSX_MAX_UPLOAD_BYTES=1073741824
TRACKVANCE_ACQUISITION_XLSX_MAX_EXPANDED_BYTES=4294967296
TRACKVANCE_ACQUISITION_XLSX_METADATA_BYTES=8388608
TRACKVANCE_ACQUISITION_XLSX_INSPECTION_BYTES=4194304
TRACKVANCE_ACQUISITION_XLSX_CACHE_BYTES=8388608
TRACKVANCE_ACQUISITION_XLSX_MAX_ENTRIES=4096
TRACKVANCE_ACQUISITION_XLSX_MAX_STYLES=65536
TRACKVANCE_ACQUISITION_XLSX_MAX_CELLS=100000000
TRACKVANCE_ACQUISITION_XLSX_MAX_RECORD_BYTES=1048576
TRACKVANCE_ACQUISITION_XLSX_TEMP_BYTES=8589934592
TRACKVANCE_ACQUISITION_XLSX_METADATA_SECONDS=10
TRACKVANCE_ACQUISITION_XLSX_INSPECTION_SECONDS=5

# Delivery preflight/preparation. One remote transaction, never commit per batch.
TRACKVANCE_DELIVERY_BATCH_ROWS=1000
TRACKVANCE_DELIVERY_SCAN_MEMORY_BYTES=268435456
TRACKVANCE_DELIVERY_MAX_ROWS=5000000
TRACKVANCE_DELIVERY_RESERVE_DISK_BYTES=536870912
TRACKVANCE_DELIVERY_SYNCHRONOUS_ROWS=100000

# Planner, real local Spark and independent dispatch. Full units/ranges in docs/development/parameters-0.7.0.md.
TRACKVANCE_DELIVERY_PREPARATION_TIMEOUT_SECONDS=1800
TRACKVANCE_WORKER_MEMORY_SOFT_BYTES=536870912
TRACKVANCE_TEMP_MIN_FREE_BYTES=536870912
TRACKVANCE_RUN_TIMEOUT_SECONDS=1800
TRACKVANCE_SPARK_MASTER=local[2]
TRACKVANCE_SPARK_DRIVER_MEMORY_MB=768
TRACKVANCE_SPARK_EXECUTOR_MEMORY_MB=768
TRACKVANCE_SPARK_EXECUTOR_CORES=1
TRACKVANCE_SPARK_TOTAL_CORES=2
TRACKVANCE_SPARK_PARTITIONS=4
TRACKVANCE_SPARK_BATCH_ROWS=2048
TRACKVANCE_SPARK_BATCH_BYTES=8388608
TRACKVANCE_SPARK_MAX_RECORD_BYTES=65536
TRACKVANCE_SPARK_MAX_GROUP_ROWS=10000
TRACKVANCE_SPARK_MAX_GROUP_BYTES=16777216
TRACKVANCE_SPARK_MAX_RESULT_BYTES=16777216
TRACKVANCE_SPARK_MEMORY_BUDGET_BYTES=2147483648
TRACKVANCE_SCHEDULER_POLL_SECONDS=5
TRACKVANCE_SCHEDULER_BATCH_SIZE=100
TRACKVANCE_EVENT_LEASE_SECONDS=300
TRACKVANCE_EVENT_POLL_SECONDS=1

# Reportes: presupuestos separados. PREVIEW nunca supera 10 filas ni escribe archivos.
REPORT_THREADS=2
REPORT_MEMORY_MB=512
REPORT_PROCESS_MEMORY_MB=2048
REPORT_CONCURRENCY=2
REPORT_BATCH_ROWS=512
REPORT_BATCH_BYTES=8388608
REPORT_MAX_JOIN_ROWS=5000000
REPORT_MAX_JOIN_EXPANSION=100
REPORT_PREVIEW_TIMEOUT_SECONDS=60
REPORT_PREVIEW_MAX_ROWS=10
REPORT_PREVIEW_MAX_BYTES=8388608
REPORT_DOWNLOAD_TIMEOUT_SECONDS=180
REPORT_DOWNLOAD_MAX_ROWS=100000
REPORT_DOWNLOAD_MAX_BYTES=134217728
REPORT_XLSX_TIMEOUT_SECONDS=180
REPORT_XLSX_MAX_ROWS=50000
REPORT_XLSX_MAX_BYTES=67108864
REPORT_DATASET_TIMEOUT_SECONDS=1800
REPORT_DATASET_MAX_ROWS=5000000
REPORT_DATASET_MAX_BYTES=2147483648
REPORT_DATASET_TEMP_BYTES=2147483648
