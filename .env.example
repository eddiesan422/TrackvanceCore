TRACKVANCE_ENV=local
TRACKVANCE_WEB_ORIGIN=http://localhost:3000
TRACKVANCE_STORAGE_ROOT=/var/lib/trackvance
# Habilita únicamente POST /api/v1/auth/demo.
DEMO_ACCESS_ENABLED=true
# Crea únicamente los datos sintéticos demo durante el arranque.
DEMO_SEED_ENABLED=true
MAX_UPLOAD_BYTES=10485760
TRACKVANCE_MAX_ROWS=100000
# Las rutas de SecretStore se fijan dentro de Compose. El modo local directo usa
# .local/credentials, .local/keys, .local/delivery_credentials y .local/delivery_keys.
TRACKVANCE_DESTINATION_SECRETS_DIR=.local/delivery_credentials
TRACKVANCE_DESTINATION_SECRET_KEY_FILE=.local/delivery_keys/master.key
POSTGRES_DB=trackvance
POSTGRES_USER=trackvance
POSTGRES_PASSWORD=replace-with-a-local-password
